//! = Exception
//NORM = Normal Items
//EXC = Exceptional Items
//ELT = Elite Items
//NMAG = Regular / Non-Magic Items
//MAG = Magic Items
//RARE = Rare Items
//UNI = Unique Items
//SET = Set Items
//CRAFT = Crafted Items
//ID = Identified Items
//INF = Inferior Items
//SUP = Superior Items
//ETH = Ethereal Items
//RW = Runeword Items
//TABSK = Group Skills
//SK = Individual Skill
//CLVL = Character Level
//FILTLVL = Filter Level
//ED = Enhanced Damage [Red] / Enhanced Defence [Blue]
//STR = Strength
//DEX = Dexterity
//VIT = Vitality
//ENE = Energy
//ATTR = All Attributes
//LF = Life
//MN = Mana
//HP = Healing Potion
//MP = Mana Potion
//JUV = Rejuvenation Potion
//LL = Life Stolen per Hit
//ML = Mana Stolen per Hit
//LAEK = Life after Each Kill
//MAEK = Mana after Each Kill
//REP = Replenish Life
//STAM = Stamina
//AR = Attack Rating
//MIN = Minimum Damage
//MAX = Maximum Damage
//DEF = Defence
//IAS = Increased Attack Speed
//FCR = Faster Cast Rate
//FHR = Faster Hit Recovery
//FBR = Faster Block Rate
//FRW = Faster Run/Walk
//CB = Crushing Blow
//DS = Deadly Strike
//OW = Open Wounds
//ITD = Ignore Target Defence
//CBF = Cannot Be Frozen
//DR = Damage Reduction
//PDR = Physical Damage Reduction
//MDR = Magic Damage Reduction
//RES = All Resistances
//FRES = Fire Resistance / Enemy Fire Resistance
//LRES = Lightning Resistance / Enemy Lightning Resistance
//CRES = Cold Resistance / Enemy Cold Resistance
//PRES = Poison Resistance / Enemy Poison Resistance
//MRES = Magic Resistance
//PHRES = Physical Resistance
//FSD = Fire Skill Damage
//LSD = Lightning Skill Damage
//CSD = Cold Skill Damage
//PSD = Poison Skill Damage
//MSD = Magic Skill Damage
//FR = Fire Damage / Fire Skills
//LTNG = Lightning Damage
//CLD = Cold Damage / Cold Skills
//MAGIC = Magic Damage / Passive and Magic Skills
//PSN = Poison Damage
//MF = Magic Find
//GF = Gold Find
//EXP = Experience Gained
//REQ = Requirements
//SOCK = Socket Number
//RUNENUM = Rune Number
//BORDER-XX = Large Map Notification
//MAP-XX = Medium Map Notification
//DOT-XX = Small Map Notification, where XX = hexadecimal color code


