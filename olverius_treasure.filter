//Filter levels: 1 Regular, 2 Soft Strict & 3 Uber Strict

//Level selection follows the ItemDisplayFilterName
ItemDisplayFilterName[]: Regular
ItemDisplayFilterName[]: Soft Strict
ItemDisplayFilterName[]: Uber Strict

