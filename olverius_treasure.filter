//LEGEND:
//▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

//! = Exception
//NORM = Normal Quality
//EXC = Exceptional Quality
//ELT = Elite Quality
//NMAG = Regular / Non-Magic Items
//MAG = Magic Items
//RARE = Rare Items
//UNI = Unique Items
//SET = Set Items
//CRAFT = Crafted Items
//ID = Identified Items
//INF = Inferior Items
//SUP = Superior Items
//ETH = Ethereal Items
//RW = Runeword Items
//TABSK = Group Skills
//SK = Individual Skill
//CLVL = Character Level
//ED = Enhenced Damage [Red]/ Defence [Blue]
//SOCK = Socket Number
//RUNENUM = Rune Number
//BORDER-XX = Large Map Notification
//MAP-XX = Medium Map Notification
//DOT-XX = Small Map Notification, where XX = hexadecimal color code


